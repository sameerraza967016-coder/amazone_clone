    <style id="BubbleLayer-mn1a0r3fpmz-STYLE">
      @font-face {
        font-family: 'McAfeePoppins';
        src: url(data:font/woff2;base64,) format('woff2');
        font-style: normal;
        font-weight: 400;
      }

      @font-face {
        font-family: 'McAfeePoppins';
        src: url(data:font/woff2;base64,) format('woff2');
        font-style: normal;
        font-weight: 600;
      }

      #BubbleLayer-mn1a0r3fpmz {
        display: flex;
        font-family: 'McAfeePoppins', sans-serif;
        padding-bottom: 16px;
        flex-direction: column;
        align-items: flex-start;
        border-radius: 8px;
        background: #FFF;
        box-shadow: 0.5px 0.5px 1px 0 rgba(0, 0, 0, 0.20), -0.25px -0.25px 1px 0 rgba(0, 0, 0, 0.06), 1px 1px 8px 0 rgba(0, 0, 0, 0.06);
        overflow: hidden;
        cursor: default;
        position: absolute;
        visibility: hidden;
        z-index: 2147483647;
      }

      #balloon__content-mn1a0r3fpmz {
        display: flex;
        padding: 0px 8px 0px 8px;
        flex-direction: column;
        align-items: flex-start;
        align-self: stretch;
      }
      
      #content__info-mn1a0r3fpmz {
        color: #343434;
        font-size: 12px;
        font-style: normal;
        font-weight: 600;
        line-height: 18px;
        margin-top: 8px;
        margin-bottom: 4px;
      }

      #balloon__status-mn1a0r3fpmz {
        display: flex;
        padding: 8px;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8px;
        align-self: stretch;
        border-radius: 8px 8px 0 0;
      }

      #content__categories-mn1a0r3fpmz {
        display: flex;
        flex-direction: column;
      }

      #content__categories-mn1a0r3fpmz > #content__cat_container {
        list-style: none;
        padding-left: 2px;
      }

      #content__categories-mn1a0r3fpmz > #content__cat_container > li {
        flex: 1 0 0;
        color: #343434;
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px;
        margin-bottom: 4px;
        padding-left: 12px;
        position: relative;
      }

      #content__categories-mn1a0r3fpmz > #content__cat_container > li:last-child {
        margin-bottom: 0px;
      }

      #content__categories-mn1a0r3fpmz > #content__cat_container > li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        width: 4px;
        height: 4px;
        background-color: #343434;
        border-radius: 50%;
        transform: translateY(-50%);
      }

      #content__separator-mn1a0r3fpmz {
        display: flex;
        flex-direction: column;
        margin-top: 8px;
        margin-bottom: 16px;
        width: 100%;
      }

      #content__separator-mn1a0r3fpmz > img {
        display: block;
        width: 100%;
        margin-left: auto;
        margin-right: auto;
      }

      #status__header-mn1a0r3fpmz {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      #status__header-mn1a0r3fpmz > #header__title {
        color: #FFF;
        font-size: 16px;
        font-style: normal;
        font-weight: 600;
        line-height: 24px;
      }

      #content__button-mn1a0r3fpmz {
        display: flex;
        flex-direction: column;
        align-items: center;
        align-self: stretch;
        padding: 0px;
      }

      #content__button-mn1a0r3fpmz > button {
        display: flex;
        padding: 5px 15px;
        justify-content: center;
        align-items: center;
        border-radius: 32px;
        background: #FFF;
        border: 1px solid #454545;
        min-width: 110px;
        max-width: 185px;
        height: 28px;
        font-family: 'McAfeePoppins', sans-serif;
        color: #454545;
        text-align: center;
        font-size: 12px;
        font-style: normal;
        font-weight: 600;
        line-height: 18px;
        cursor: pointer;
      }

      #status__wa_logo-mn1a0r3fpmz {
        display: flex;
        padding-right: 8px;
        justify-content: center;
        align-items: flex-end;
        align-self: stretch;
      }

      #status__wa_logo-mn1a0r3fpmz > img {
        width: 69px;
        height: 13px;
      }
    </style>
